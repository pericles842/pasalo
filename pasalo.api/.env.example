# ==========================================
# PÁSALO API — Entorno de desarrollo
# ==========================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# Origen del frontend, separados por coma. Deberia haber UNO por entorno: la web
# se sirve desde un unico origen canonico y Traefik redirige el resto (ver
# docs/CORS_DOMINIOS.md). Sin comillas, sin espacios, sin slash final.
# Produccion: CORS_ORIGIN=https://pasalo.co.ve
CORS_ORIGIN=http://localhost:4200

# --- Base de datos MASTER (pasalo-master) ---
# Las DB por compañía (pasalo_<tenant_id>) se crean en este mismo motor
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pasalo-master
DB_USER=root
DB_PASS=

# --- Auth ---
JWT_SECRET=

# --- Google OAuth (login con Google) ---
# Client ID de un OAuth Client ID tipo "Web application" en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (comprobantes / logos) ---
# Region siempre "auto" en R2
AWS_REGION=auto
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Endpoint S3-compatible del bucket (dashboard R2 -> bucket -> Configuracion -> S3 API)
R2_ENDPOINT=
# URL publica del bucket (dashboard R2 -> bucket -> Configuracion -> Acceso publico), sin slash final
R2_PUBLIC_URL=

# --- Pagos ---
PAYMENT_BASE_URL=http://localhost:4200/p

# --- Archivos ---
API_PUBLIC_URL=http://localhost:3000

# --- Tasa de cambio ---
# Token compartido para POST /exchange-rate/sync?token=... (query param), usado
# por el demonio externo que refresca la tabla `rates`.
RATES_SYNC_TOKEN=
